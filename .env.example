# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# NOTE: for the DOCKER deployment (deploy/docker/), deploy.sh writes its own
# deploy/docker/.env with the vars the compose file reads (ADMIN_*, MONGO_*,
# SERVER_ID, PROJECTS_ROOT, ports, …) and the Mongo URI is assembled there. This
# top-level .env is for a bare-metal / non-docker run.

# Mongo connection. Docker deploy assembles this from MONGO_USER/MONGO_PASSWORD; set
# it directly only for a non-docker run. Auth is enforced (--auth) — no anonymous access.
INFRADOCS_MONGO_URI=mongodb://infradocs:PASSWORD@localhost:27018/?authSource=admin

# Mongo credentials the docker compose uses (deploy.sh generates a random password).
MONGO_USER=infradocs
MONGO_PASSWORD=

# API basic-auth password. No committed fallback — the config-credential path is
# disabled entirely when this is unset (see app/api/dependencies.py).
INFRADOCS_API_PASSWORD=
