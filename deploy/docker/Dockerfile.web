# Web tier: build the React frontend, serve it behind Caddy (auto Let's Encrypt
# TLS when DOMAIN is a real hostname; plain HTTP for localhost/parallel UAT).
FROM node:20-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
# `npm ci` builds strictly from the committed lockfile — deterministic and
# reproducible, unlike `npm install` which can silently drift the dep tree.
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY deploy/docker/Caddyfile /etc/caddy/Caddyfile
